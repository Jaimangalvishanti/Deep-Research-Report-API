# GROQ_API_KEY: Required for AI summarization and synthesis (llama-3.3-70b).
GROQ_API_KEY="your_groq_api_key"

# METAMASK_WALLET_ADDRESS: Your Base wallet address to receive USDC payments.
METAMASK_WALLET_ADDRESS="0xYourWalletAddress"

# GEMINI_API_KEY: Optional if you want to use Gemini as fallback, but PRD focuses on Groq.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
